# Environment Variables for Smart Attendance System
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask Secret Key - CHANGE THIS before deployment!
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Database path (optional - defaults to database/attendance.db)
# DATABASE_PATH=database/attendance.db

# Admin credentials (set via DB seed, not env - just for reference)
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=admin123
